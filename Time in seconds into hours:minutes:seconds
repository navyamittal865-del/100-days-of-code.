// Q10: Write a program to input time in seconds and convert it to hours:minutes:seconds format.

#include<stdio.h>

int main()
{
    int sec, min, hour;
    printf("Enter time in seconds: ");
    scanf("%d", &sec);
    hour = sec / 3600;
    min = (sec % 3600) / 60;
    sec = sec % 60;
    printf("Time is %d:%d:%d\n", hour, min, sec);
    return 0;
}
