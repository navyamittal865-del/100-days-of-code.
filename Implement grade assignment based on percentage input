// Q18: Write a program that accepts a percentage (0-100) and assigns a grade.

#include<stdio.h>

int main()
{
    int n;
    printf("Enter a number: ");
    scanf("%d", &n);

    if(n>=90 && n<=100)
    {
        printf("Grade A");
    }
    else if(n>=80 && n<=89)
    {
        printf("Grade B");

    }
    else if(n>=70 && n<=79)
    {
        printf("Grade C");
    }
    else if(n>=60 && n<=69)
    {
        printf("Grade D");
    }
    else if(n>=0 && n<=59)
    {
        printf("Grade F");
    }
    else
    {
        printf("Invalid input");
    }
    return 0;
}
