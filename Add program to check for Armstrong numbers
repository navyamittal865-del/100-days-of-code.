// Q33: Write a program to check if a number is an Armstrong number.

#include <stdio.h>
#include <math.h>

int main() 
{
    int num, originalNum, remainder, digits = 0;
    int result = 0;

    scanf("%d", &num);

    originalNum = num;

    while (originalNum != 0) 
    {
        digits++;
        originalNum /= 10;
    }

    originalNum = num;

    while (originalNum != 0) 
    {
        remainder = originalNum % 10;
        result += pow(remainder, digits);
        originalNum /= 10;
    }

    if (result == num)
        printf("Armstrong");
    else
        printf("Not Armstrong");

    return 0;
}
